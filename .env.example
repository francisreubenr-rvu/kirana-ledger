# Leave SARVAM_API_KEY empty to run fully offline in mock mode.
SARVAM_API_KEY=
# KIRANA_MOCK=1            # force mock even when a key is set

# LLM planner: sarvam (default when a key is set) | openai (any OpenAI-compatible endpoint) | rules (offline)
# LLM_PROVIDER=sarvam
# LLM_MODEL=sarvam-105b    # or sarvam-105b-conversations (32K ctx, tuned for voice agents)
# LLM_URL=https://api.sarvam.ai/v2/chat/completions   # optional override (V1 is the default)
# LLM_REASONING_EFFORT=low # none|low|medium|high; low keeps latency down
# For LLM_PROVIDER=openai:  LLM_URL=https://openrouter.ai/api/v1/chat/completions  LLM_MODEL=...  OPENAI_API_KEY=...

# STT_MODEL=saaras:v4  STT_MODE=codemix  STT_LANGUAGE=unknown
# TTS_MODEL=bulbul:v4-flash  TTS_SAMPLE_RATE=16000
# TTS_SPEAKER_HI=shubh_hi_customer  TTS_SPEAKER_KN=chaitra_kn_conversation  TTS_SPEAKER_TA=gokul_ta_narration

SHOP_NAME="Sri Lakshmi Kirana"
OWNER_LANG=auto            # auto (reply in the language spoken) | hi | kn | ta | en
KIRANA_DB=kirana.db
